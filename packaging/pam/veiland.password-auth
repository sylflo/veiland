# PAM configuration for veiland's password check (Fedora/RHEL).
# Authenticate only: no account, session, or password phase. A locker
# re-verifies an existing session; it does not admit a new one.
# password-auth, not system-auth: with authselect's with-fingerprint
# feature, system-auth also runs pam_fprintd, which would make every
# password attempt wait for the reader. Fingerprint unlock is the
# separate veiland-fingerprint service, run in parallel (as gdm does).
auth     include  password-auth
