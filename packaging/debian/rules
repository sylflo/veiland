#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Build veiland the same way as the Arch/Fedora packages: cargo build
# --release --locked restricted to the real set. We override dh's build/
# test/install steps rather than use dh-cargo, so all three distro
# packages build identically.

export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR = $(CURDIR)/target

CRATES = \
 -p veiland-core \
 -p veiland-wallpaper \
 -p veiland-particles \
 -p veiland-vignette \
 -p veiland-sakura \
 -p veiland-snow \
 -p veiland-rain \
 -p veiland-embers \
 -p veiland-fireflies \
 -p veiland-gradient \
 -p veiland-parallax \
 -p veiland-blobs \
 -p veiland-raymarcher

# Test set: the shipped crates plus the library crates compiled into
# them. `cargo test -p` only runs the named packages' tests, so the
# libraries need their own -p flags or their suites never run.
# Test-only; they produce no installed artifact.
TEST_CRATES = $(CRATES) \
 -p veiland-protocol \
 -p veiland-plugin \
 -p veiland-text

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked $(CRATES)

override_dh_auto_test:
	# spawn_true_exits_zero needs /bin/true; present here, so no skip.
	cargo test --release --locked $(TEST_CRATES)

override_dh_auto_install:
	# Files are staged by dh_install (debian/veiland.install) and
	# dh_installpam (debian/veiland.pam); the default cargo install is
	# not what we want, so this override is intentionally empty.

execute_after_dh_install:
	# dh_install can't rename. The example config must land as
	# config.example.toml — the name the Arch and RPM packages install,
	# the name its own usage comment tells users to cp, and the name the
	# CI install-check asserts.
	mv debian/veiland/usr/share/veiland/veiland.example.toml \
	   debian/veiland/usr/share/veiland/config.example.toml
	# The hotplug repro config is a dev tool, and the two battery demo scenes
	# reference widgets not installed as commands (battery.py / battery_cairo.py)
	# -- drop all three. The scenes already reference every plugin by its bare
	# veiland-<name> (Rust and Python alike), so only the repo-relative asset
	# paths need rewriting to the installed wallpaper.
	rm debian/veiland/usr/share/veiland/examples/hotplug-repro.toml \
	   debian/veiland/usr/share/veiland/examples/battery_python.toml \
	   debian/veiland/usr/share/veiland/examples/battery_cairo.toml
	sed -i 's|docs/examples/assets/|/usr/share/veiland/|' \
	   debian/veiland/usr/share/veiland/examples/*.toml
	# Python widgets. dh_install can't rename or generate, so stage them here:
	# the SDK + companions + renamed widget scripts + icons under
	# /usr/lib/veiland/python (preserving the python/examples/ layout so each
	# widget's own sys.path shim + ICON_DIR resolve unmodified -- no .py edit),
	# and a tiny exec shim per widget in /usr/bin (a shim, NOT a symlink, which
	# would resolve __file__ back to /usr/bin and break the shims; and no env
	# wrapper -- Debian's gi loader finds the default GI path). Mirrors the Arch
	# PKGBUILD and the flake, kept in lockstep.
	install -dm755 debian/veiland/usr/lib/veiland/python/examples
	install -m644 python/veiland_plugin.py python/veiland_svg.py \
	   python/veiland_text.py python/veiland_layout.py python/veiland_dbus.py \
	   debian/veiland/usr/lib/veiland/python/
	cp -r python/examples/icons \
	   debian/veiland/usr/lib/veiland/python/examples/icons
	install -dm755 debian/veiland/usr/bin
	set -e; for pair in \
	   veiland-now-playing:now_playing.py \
	   veiland-weather:weather.py \
	   veiland-wifi:wifi.py \
	   veiland-ethernet:ethernet.py \
	   veiland-bluetooth:bluetooth.py \
	   veiland-avatar:avatar.py \
	   veiland-markup:markup.py \
	   veiland-shape:shape.py \
	   veiland-battery:battery_svg.py; do \
	   name=$${pair%%:*}; src=$${pair##*:}; \
	   install -m755 python/examples/$$src \
	      debian/veiland/usr/lib/veiland/python/examples/$$name; \
	   printf '#!/bin/sh\nexec /usr/lib/veiland/python/examples/%s "$$@"\n' $$name \
	      > debian/veiland/usr/bin/$$name; \
	   chmod 755 debian/veiland/usr/bin/$$name; \
	done
